# Core
APP_NAME=BCREC AI
DEBUG=true

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL=1800

# PostgreSQL
POSTGRES_DSN=postgresql+asyncpg://bcrec:bcrec_dev@localhost:5432/bcrec
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# SQLite fallback
SQLITE_PATH=data/conversations.db

# OpenTelemetry
OTEL_SERVICE_NAME=bcrec-ai
OTEL_ENDPOINT=

# Feature Flags (set to true to enable)
USE_REDIS_SESSIONS=false
USE_POSTGRES_HISTORY=false
USE_OTEL=false

# LiveKit
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=wss://bcrec-ai-xxxx.livekit.cloud

# Groq
GROQ_API_KEY=

# Sarvam AI
SARVAM_API_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
